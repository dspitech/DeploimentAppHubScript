# ============================================================
# PLG - 2026 / Groupe 24 : ESTIAM - Paris
# terraform.tfvars.example
# ============================================================

# ----------------------------
# Général
# ----------------------------
rg_name  = "RG-PLG-ESTIAM-Paris-2026"
location = "norwayeast"

# ----------------------------
# Authentification VMs
# ----------------------------
admin_username      = "scripttools_plgEstiam"
ssh_public_key_path = "/home/azure-4clazur/.ssh/hubspoke_rsa.pub"

# ----------------------------
# Application / GitHub
# ----------------------------
github_repo_url = "https://github.com/dspitech/plg-projet-pedagogique-2026-groupe-24.git"
repo_name       = "plg-projet-pedagogique-2026-groupe-24"
github_owner    = "dspitech"
github_pat      = ""

# ----------------------------
# Supabase (SECRETS — à ne jamais committer avec de vraies valeurs)
# ----------------------------
supabase_url      = ""
supabase_anon_key = ""
database_url      = ""

# ----------------------------
# Supervision (Grafana admin password — SECRET)
# ----------------------------
grafana_admin_user     = "admin"
grafana_admin_password = "Dspi@1996@Estiam12"
grafana_allowed_source = "81.220.68.129/32" # ajoutez votre IP publique en /32 si besoin d'accès direct
monitoring_vm_size = "Standard_D2s_v3"

# ----------------------------
# Supabase — datasource PostgreSQL de Grafana (lecture seule recommandée)
# Project Settings > Database > Connection info dans Supabase.
# Utiliser le "Connection pooler" (port 6543) plutôt que la connexion
# directe (5432) : Grafana ouvre peu de connexions persistantes, le pooler
# évite de saturer les connexions Postgres de Supabase.
# ----------------------------
supabase_db_host     = "aws-0-eu-west-3.pooler.supabase.com"
supabase_db_port     = "6543"
supabase_db_name     = "postgres"
supabase_db_user     = "grafana_reader.xxxxxxxxxxxxxxxxxxxx" # rôle dédié, voir README
supabase_db_password = ""

# ----------------------------
# Alertes Grafana (section 12.3) — webhook Slack/Discord/Teams/générique.
# Laisser vide pour désactiver l'envoi : les 3 règles restent actives et
# visibles dans Grafana > Alerting, sans notification externe.
# ----------------------------
grafana_alert_webhook_url = ""

# ----------------------------
# Tags
# ----------------------------
tags = {
  Project     = "Deployment-Script-Tools"
  Environment = "Production"
  ManagedBy   = "Terraform"
  Author      = "PLG-Groupe24-ESTIAM-2026"
}
